# GitHub Pages (npm run deploy:pages): the remote to push the gh-pages branch to.
# A remote name (default: origin) or a repository URL.
PAGES_REMOTE=origin
# Optional: custom domain for GitHub Pages (writes a CNAME file), e.g. notes.example.com
PAGES_CNAME=

# Your own server (npm run deploy): where rsync copies dist/, as user@host:/path/
# e.g. me@myserver.com:/var/www/mysite/interviewing/
DEPLOY_TARGET=
